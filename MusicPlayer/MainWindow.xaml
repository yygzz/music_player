<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fx="clr-namespace:MusicPlayer.Effects"
        mc:Ignorable="d"
        Title="Music Player"
        Width="1180" Height="760"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized">

    <Grid>
        <!-- ================================================================
             背景层：缓慢移动的彩色光斑（Canvas + Ellipse + BlurEffect 动画）
             ================================================================ -->
        <Canvas x:Name="BgCanvas" IsHitTestVisible="False" ClipToBounds="True">

            <Ellipse x:Name="Blob1" Width="360" Height="360"
                     Canvas.Left="-80" Canvas.Top="140" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4D59C2FF" Offset="0"/>
                        <GradientStop Color="#0059C2FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="90"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Blob2" Width="320" Height="320"
                     Canvas.Left="360" Canvas.Top="-60" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4DFF5CA8" Offset="0"/>
                        <GradientStop Color="#00FF5CA8" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Blob3" Width="420" Height="420"
                     Canvas.Left="900" Canvas.Top="80" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#408B7CF6" Offset="0"/>
                        <GradientStop Color="#008B7CF6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Blob4" Width="300" Height="300"
                     Canvas.Left="640" Canvas.Top="520" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#40FFB35C" Offset="0"/>
                        <GradientStop Color="#00FFB35C" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="85"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- 一层很淡的暗角渐变，增加纵深感 -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#18000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.55"/>
                    <GradientStop Color="#26000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ================================================================
             主布局：左侧侧边栏 + 右侧内容区
             ================================================================ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 侧边栏（半透明圆角毛玻璃卡片） ============ -->
            <Border Style="{StaticResource GlassCardStyle}"
                    Width="236" Margin="16,16,10,16"
                    VerticalAlignment="Stretch">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo / 标题 -->
                    <StackPanel Orientation="Horizontal" Margin="10,10,10,12">
                        <Border Width="32" Height="32" CornerRadius="7" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="#101419" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Music Player" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Windows 11 Fluent" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 可拖拽排序的图标导航列表 -->
                    <ListBox x:Name="NavList" Grid.Row="1"
                             Margin="0,0,0,8"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="NavList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="NavList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="NavList_PreviewMouseLeftButtonUp"
                             MouseLeave="NavList_MouseLeave"
                             LostMouseCapture="NavList_LostMouseCapture"
                             ItemsSource="{Binding NavItems}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Margin="2,2" Padding="10,8"
                                                    CornerRadius="6" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 选中时的亚克力光点 -->
                                                    <Ellipse x:Name="GlowDot" Width="22" Height="22" Margin="-4,0,0,0"
                                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                                             Fill="{StaticResource AccentBrush}" Opacity="0"
                                                             IsHitTestVisible="False">
                                                        <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
                                                    </Ellipse>
                                                    <TextBlock x:Name="IconText" Text="{Binding Glyph}"
                                                               FontFamily="{StaticResource IconFont}" FontSize="16"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}"
                                                               FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#26FFFFFF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#20FFFFFF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                                    <Setter TargetName="GlowDot" Property="Opacity" Value="0.55"/>
                                                    <Setter TargetName="IconText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 底部：设置 -->
                    <Button Grid.Row="2" Margin="2,4,2,2" HorizontalContentAlignment="Left"
                            Style="{StaticResource GlowButtonStyle}"
                            fx:Glow.IsEnabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 右侧内容区 ============ -->
            <Grid Grid.Column="1" Margin="0,16,16,16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部栏：搜索框 + 窗口控制按钮（可拖拽移动窗口） -->
                <Grid x:Name="TopBar" Height="48"
                      MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 搜索框：聚焦时底部亮线下划线从点击处向两侧展开 -->
                    <Border x:Name="SearchBorder" Width="360" Height="40" HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="8" Background="#14FFFFFF"
                            BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Padding="36,0,10,0"
                                     PreviewMouseLeftButtonDown="SearchTextBox_PreviewMouseLeftButtonDown"
                                     LostKeyboardFocus="SearchTextBox_LostKeyboardFocus"/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <Rectangle x:Name="SearchUnderline" Height="2" RadiusX="1" RadiusY="1"
                                       Fill="{StaticResource AccentBrush}"
                                       Margin="6,0,6,0" VerticalAlignment="Bottom"
                                       IsHitTestVisible="False"
                                       RenderTransformOrigin="0,0">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform CenterX="0" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- 窗口控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource WindowButtonStyle}" fx:Glow.IsEnabled="True"
                                Click="MinimizeButton_Click"
                                ToolTip="最小化">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}"/>
                        </Button>
                        <Button Style="{StaticResource WindowButtonStyle}" fx:Glow.IsEnabled="True"
                                Click="MaximizeRestoreButton_Click"
                                ToolTip="最大化/还原">
                            <TextBlock Text="&#xE922;" FontFamily="{StaticResource IconFont}"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButtonStyle}" fx:Glow.IsEnabled="True"
                                Click="CloseButton_Click"
                                ToolTip="关闭">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 主体：正在播放 + 播放列表 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============ 正在播放卡片 ============ -->
                    <Border Style="{StaticResource GlassCardStyle}" Width="360" Margin="0,0,12,0">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabelStyle}"/>

                            <!-- 封面 + 信息 -->
                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Border Width="168" Height="168" CornerRadius="8"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF5C8A" Offset="0"/>
                                            <GradientStop Color="#8B5CF6" Offset="0.55"/>
                                            <GradientStop Color="#59C2FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="#000000"/></Border.Effect>
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="54"
                                               Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="184,4,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="Midnight Bloom" FontSize="21" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Lumen" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="Neon City Nights · 2026" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 播放控制 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,22,0,0"
                                        HorizontalAlignment="Center">
                                <Button Style="{StaticResource RoundIconButtonStyle}" fx:Glow.IsEnabled="True"
                                        ToolTip="上一首" Width="36" Height="36">
                                    <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource RoundPlayButtonStyle}" fx:Glow.IsEnabled="True"
                                        Margin="14,0" ToolTip="播放/暂停">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                                </Button>
                                <Button Style="{StaticResource RoundIconButtonStyle}" fx:Glow.IsEnabled="True"
                                        ToolTip="下一首" Width="36" Height="36">
                                    <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </Button>
                            </StackPanel>

                            <!-- 进度条 -->
                            <Grid Grid.Row="3" Margin="0,22,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Slider Grid.Row="0" Style="{StaticResource ProgressSliderStyle}" Minimum="0"
                                        Maximum="100" Value="42"/>
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <TextBlock Text="1:24" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="3:24" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ 播放列表卡片 ============ -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                        <Grid Margin="20,18,20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="UP NEXT" Style="{StaticResource SectionLabelStyle}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                                <TextBlock Text="Neon City Nights" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="  ·  8 tracks" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Songs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="6" Padding="10,8" Margin="0,1"
                                                    Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="13" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" FontSize="11.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
